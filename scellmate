# run_check() {
#  echo "Running check module..."
#  echo "  - Verifying scripts"
#  echo "  - Verifying databases"
#  echo "  - Verifying software availability"
#  "$SCM_MODULES/check_environment.sh"
# }

run_end_to_end() {
  echo "Running end-to-end pipeline..."
  local input_dir=""
  local workdir=""
  local prefix=""
  local threads=48
  local max_CoSAG_cont=10
  local score_cutoff=0.7

  while [[ $# -gt 0 ]]; do
    case $1 in
      -i|--input)  input_dir="$2";   shift 2 ;;
      -o|--output) workdir="$2";     shift 2 ;;
      --prefix)    prefix="$2";      shift 2 ;;
      -t|--threads) threads="$2";     shift 2 ;;
      --max_CoSAG_cont) max_CoSAG_cont="$2"; shift 2 ;;
      --score_cutoff) score_cutoff="$2"; shift 2 ;;
      -h|--help)
        echo "Usage: scellmate end_to_end -i <input> -o <workdir> --prefix <prefix> [-t <threads>] [--max_CoSAG_cont <value>] [--score_cutoff <value>]"
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$input_dir" || -z "$workdir" || -z "$prefix" ]]; then
    echo "Error: -i, -o and --prefix are required" >&2
    exit 1
  fi

  run_preprocess -i "$input_dir" -o "$workdir" --prefix "$prefix" -t "$threads"
  run_first_qc --workdir "$workdir" -t "$threads"
  run_second_qc --workdir "$workdir" -t "$threads" --max_CoSAG_cont "$max_CoSAG_cont"
  run_link_eMGE --workdir "$workdir" -t "$threads" --score_cutoff "$score_cutoff"
  echo "=== Scellmate complete ==="
}

# ========================== Main ==========================
case "$MODULE" in
  preprocess)
    run_preprocess "${MODULE_ARGS[@]}"
    ;;
  first_qc)
    run_first_qc "${MODULE_ARGS[@]}"
    ;;
  second_qc)
    run_second_qc "${MODULE_ARGS[@]}"
    ;;
  link_eMGE)
    run_link_eMGE "${MODULE_ARGS[@]}"
    ;;
  # check)
  #   run_check "${MODULE_ARGS[@]}"
  #   ;;
  end_to_end)
    run_end_to_end "${MODULE_ARGS[@]}"
    ;;
  set_default_db)
    raw_path="${MODULE_ARGS[0]}"
    if ! abs_path=$(realpath -m "$raw_path" 2>/dev/null); then
      abs_path="$(cd "$(dirname "$raw_path")" && pwd)/$(basename "$raw_path")"
    fi

    env_dir="${CONDA_PREFIX:?}"
    activate_dir="$env_dir/etc/conda/activate.d"
    mkdir -p "$activate_dir"

    cat <<EOF > "$activate_dir/set_scellmate_db.sh"
#!/usr/bin/env bash
export SCELLMATE_DB="$abs_path"
EOF
    chmod +x "$activate_dir/set_scellmate_db.sh"
    echo "[Scellmate] Default database set to: $abs_path"
    ;;
  set_GTDB_db)
    raw_path="${MODULE_ARGS[0]}"
    if ! abs_path=$(realpath -m "$raw_path" 2>/dev/null); then
      abs_path="$(cd "$(dirname "$raw_path")" && pwd)/$(basename "$raw_path")"
    fi

    env_dir="${CONDA_PREFIX:?}"
    activate_dir="$env_dir/etc/conda/activate.d"
    mkdir -p "$activate_dir"

    cat <<EOF > "$activate_dir/set_gtdb_path.sh"
#!/usr/bin/env bash
export SCELLMATE_GTDB_PATH="$abs_path"
EOF
    chmod +x "$activate_dir/set_gtdb_path.sh"
    echo "[Scellmate] GTDB-Tk database path set to: $abs_path"
    ;;
    set_tmp)
    raw_path="${MODULE_ARGS[0]:-/dev/shm}"
    if ! abs_path=$(realpath -m "$raw_path" 2>/dev/null); then
      abs_path="$(cd "$(dirname "$raw_path")" && pwd)/$(basename "$raw_path")"
    fi

    env_dir="${CONDA_PREFIX:?}"
    activate_dir="$env_dir/etc/conda/activate.d"
    mkdir -p "$activate_dir"

    cat <<EOF > "$activate_dir/set_tmp.sh"
#!/usr/bin/env bash
export TMP_FILESYSTEM_PATH="$abs_path"
EOF

    chmod +x "$activate_dir/set_tmp.sh"
    echo "[Scellmate] Temporary filesystem path set to: $abs_path"
    ;;
  -v|--version)
    echo "Scellmate v$VERSION"
    ;;
  -h|--help)
    help_message
    ;;
  *)
    echo -e "${RED}[ERROR] Unknown module: $MODULE${NC}"
    help_message
    exit 1
    ;;
esac

